@inject PlanetApiClient PlanetApi

<MudDialog>
    <DialogContent>
        <EditForm Model="@_model" OnValidSubmit="SubmitAsync" id="create-planet-form">
            <DataAnnotationsValidator />
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_model.Name" Label="Name" For="@(() => _model.Name)" Variant="Variant.Outlined" />
                <MudNumericField @bind-Value="_model.Mass" Label="Mass (10²⁴ kg)" For="@(() => _model.Mass)"
                                 Variant="Variant.Outlined" Min="0.001" />
                <MudNumericField @bind-Value="_model.Radius" Label="Radius (km)" For="@(() => _model.Radius)"
                                 Variant="Variant.Outlined" Min="0.001" />
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error">@_error</MudAlert>
                }
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   form="create-planet-form" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    private readonly CreatePlanetRequest _model = new();
    private bool _busy;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        var result = await PlanetApi.CreateAsync(_model);
        _busy = false;

        if (result.Success && result.Value is not null)
            Dialog.Close(DialogResult.Ok(result.Value));
        else
            _error = result.Error;
    }

    private void Cancel() => Dialog.Cancel();
}
